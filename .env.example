# Copy to .env and adjust.

# Time zone for the UI, e.g. America/New_York, Europe/London
TZ=UTC

# User/group that owns your media files (run `id` on the host to find them)
PUID=1000
PGID=1000

# Web UI port on the host
WEB_PORT=8080

# Optional login for the web UI (leave blank to disable)
AUTH_USERNAME=
AUTH_PASSWORD=

# Host folder holding the app's database and settings
CONFIG_DIR=./config

# Host folder where NZBGet puts completed downloads (NZBGet's DestDir)
NZBGET_COMPLETED_DIR=./nzbget-completed

# Host folder completed downloads are moved into
TARGET_DIR=./library

# Docker image to run (default: the image published from GitHub)
# IMAGE=ghcr.io/cerlendson/autousenetdownloader:latest
